      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "applied_filter",
            "format": "regexp",
            "regExp": "classification in \\((?<clearance>[^)]*)\\).*department in \\((?<departments>[^)]*)\\)",
            "replace": false
