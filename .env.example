# Inference (OpenAI-compatible).
# Inside Compose, the models: block injects LLM_BASE_URL=http://model-runner.docker.internal/v1/ and LLM_MODEL.
# Host-side defaults for `uv run` outside Compose use Model Runner's TCP endpoint (enabled with
# `docker desktop enable model-runner --tcp=12434`):
LLM_BASE_URL=http://localhost:12434/engines/v1
LLM_MODEL=ai/qwen3.5:9b-q4_K_M
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=0

# Embeddings
EMBED_BASE_URL=http://localhost:12434/engines/v1
EMBED_MODEL=hf.co/gpustack/bge-m3-gguf:Q8_0
EMBED_DIM=1024

# Judge model for the generation eval. Must be a different model family from LLM_MODEL;
# the run refuses to start when they are equal.
JUDGE_BASE_URL=http://localhost:12434/engines/v1
JUDGE_MODEL=ai/gemma4:12b-q4_K_M
JUDGE_API_KEY=not-needed

# Labels written into every eval result file. Change them when the models run elsewhere
# (for example ENGINE_BACKEND=vllm for a full-precision run).
ENGINE=docker-model-runner
ENGINE_BACKEND=llama.cpp

# Storage
DATABASE_URL=postgresql://sovrag:sovrag@localhost:5432/sovrag

# MCP server (sovrag serve-mcp). MCP_IDENTITY is required: "static" binds PRINCIPAL at startup;
# "mattermost" binds each tool call to the Mattermost user the Agents plugin names, after the
# plugin proves itself with MCP_SHARED_SECRET as a bearer. The agent can never choose the
# principal (ADR 0009). MCP_ALLOWED_HOSTS lists accepted Host header values, comma separated.
MCP_IDENTITY=static
PRINCIPAL=analyst_dnd
MCP_SHARED_SECRET=
MCP_ALLOWED_HOSTS=

# HTTP API (sovrag serve). API_IDENTITY is required: "static" binds PRINCIPAL at startup;
# "gateway" trusts an authenticating gateway that sends API_SHARED_SECRET as a bearer and the
# principal id in X-Sovrag-Principal. GET /healthz needs neither. See ADR 0015.
API_IDENTITY=static
API_SHARED_SECRET=

# MCP server, mattermost mode only. The resolver reads user attributes
# from MATTERMOST_URL with MATTERMOST_BOT_TOKEN. See ADR 0010.
MATTERMOST_URL=http://localhost:8065
MATTERMOST_BOT_TOKEN=
# The seed script prints MATTERMOST_URL, MATTERMOST_BOT_TOKEN and MCP_SHARED_SECRET for the
# mattermost profile; inside Compose the URL is http://mattermost:8065.

# The Agents plugin's own model (the seed script writes it into the plugin's settings). Defaults
# are Model Runner inside Compose. To point the plugin at Baseten Model APIs set:
#   AGENT_LLM_URL=https://inference.baseten.co/v1
#   AGENT_LLM_MODEL=<a model id from the catalog>
#   AGENT_LLM_API_KEY=<your Baseten key>
#   AGENT_LLM_SERVICE_NAME=Baseten Model APIs
# then re-run the seed script. Keys never leave .env. See docs/serving-backends.md.
AGENT_LLM_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
AGENT_LLM_SERVICE_NAME=

# sovrag's own generator on Baseten Model APIs, via the override file:
#   docker compose -f compose.yaml -f compose.baseten.yaml --profile mattermost --profile mcp up -d
# For host-side runs (`uv run sovrag eval generation`) set LLM_BASE_URL, LLM_MODEL and LLM_API_KEY
# to the same values on the command line. Embeddings and the judge stay on Model Runner.
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=
BASETEN_API_KEY=
LLM_API_KEY=not-needed

# Audit log (JSONL)
AUDIT_LOG_PATH=./audit.jsonl

# Named principals (YAML). Both `sovrag query` and `sovrag ask` resolve --principal here.
PRINCIPALS_PATH=data/principals.yaml
