# Inference (OpenAI-compatible).
# Inside Compose, the models: block injects LLM_BASE_URL=http://model-runner.docker.internal/v1/ and LLM_MODEL.
# Host-side defaults for `uv run` outside Compose use Model Runner's TCP endpoint (enabled with
# `docker desktop enable model-runner --tcp=12434`):
LLM_BASE_URL=http://localhost:12434/engines/v1
LLM_MODEL=ai/qwen3.5:9b-q4_K_M
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=0

# Embeddings
EMBED_BASE_URL=http://localhost:12434/engines/v1
EMBED_MODEL=hf.co/gpustack/bge-m3-gguf:Q8_0
EMBED_DIM=1024

# Judge model for the generation eval. Must be a different model family from LLM_MODEL;
# the run refuses to start when they are equal.
JUDGE_BASE_URL=http://localhost:12434/engines/v1
JUDGE_MODEL=ai/gemma4:12b-q4_K_M
JUDGE_API_KEY=not-needed

# Labels written into every eval result file. Change them when the models run elsewhere
# (for example ENGINE_BACKEND=vllm for a full-precision run).
ENGINE=docker-model-runner
ENGINE_BACKEND=llama.cpp

# Storage
DATABASE_URL=postgresql://sovrag:sovrag@localhost:5432/sovrag

# MCP server only (not implemented yet). The server binds the principal, never the agent:
# from this value at startup in static mode, or per tool call from an authenticated
# transport in mattermost mode. See ADR 0009.
PRINCIPAL=analyst_dnd

# Audit log (JSONL)
AUDIT_LOG_PATH=./audit.jsonl

# Named principals (YAML). Both `sovrag query` and `sovrag ask` resolve --principal here.
PRINCIPALS_PATH=data/principals.yaml
