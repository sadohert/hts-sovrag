# Inference (OpenAI-compatible).
# Inside Compose, the models: block injects LLM_BASE_URL=http://model-runner.docker.internal/v1/ and LLM_MODEL.
# Host-side defaults for `uv run` outside Compose use Model Runner's TCP endpoint (enabled with
# `docker desktop enable model-runner --tcp=12434`):
LLM_BASE_URL=http://localhost:12434/engines/v1
LLM_MODEL=ai/qwen3.5:9b-q4_K_M
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=0

# Embeddings
EMBED_BASE_URL=http://localhost:12434/engines/v1
EMBED_MODEL=hf.co/gpustack/bge-m3-gguf:Q8_0
EMBED_DIM=1024

# Judge model for generation eval (must differ from LLM_MODEL). Cohere compat endpoint or a second DMR model.
JUDGE_BASE_URL=http://localhost:12434/engines/v1
JUDGE_MODEL=
JUDGE_API_KEY=

# Storage
DATABASE_URL=postgresql://sovrag:sovrag@localhost:5432/sovrag

# MCP server only: the principal is bound here at startup, never passed by the agent.
PRINCIPAL=analyst_dnd

# Audit log (JSONL)
AUDIT_LOG_PATH=./audit.jsonl
